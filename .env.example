# ============================================================
#  FINEXA — Variáveis de Ambiente
#  Copie este arquivo para .env.local e preencha os valores.
#  NUNCA commite o arquivo .env.local no git.
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# SERVICE_ROLE_KEY: apenas server-side, NUNCA expor com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin / Cron ---
# Gere com: openssl rand -hex 32
ADMIN_SECRET=gere_um_valor_aleatorio_forte
CRON_SECRET=gere_um_valor_aleatorio_forte_diferente_do_admin

# --- MercadoPago ---
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
# Segredo do webhook — configurado no painel do MercadoPago em Webhooks → Assinatura secreta
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# --- Upstash Redis (rate limiting) ---
# Crie em https://console.upstash.com — plano gratuito disponível
UPSTASH_REDIS_REST_URL=https://SEU_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu_token_upstash_aqui

# --- Email (Resend) ---
RESEND_API_KEY=sua_api_key_aqui

# --- Push Notifications (VAPID) ---
# Gere em: https://web-push-codelab.glitch.me
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua_vapid_public_key
VAPID_PRIVATE_KEY=sua_vapid_private_key